# Frontend Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database Environment (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insight_ignite?schema=public

# Session Security
SESSION_COOKIE_NAME=insight_session
SESSION_SECRET=replace-with-cryptographically-secure-random-secret
SESSION_MAX_AGE_DAYS=7

# SMTP Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Insight Ignite <support@insightignite.org>"
